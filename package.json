{
  "name": "jobnaut",
  "version": "1.0.0",
  "description": "JobNaut - AI-Powered Job Market Navigator",
  "main": "index.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "test": "jest",
    "test:frontend": "cd frontend && npm test",
    "test:all": "npm test && npm run test:frontend",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:job": "NODE_ENV=test env-cmd -f .env.test jest --testNamePattern='Job'",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "chatbot:dev": "node scripts/chatbot-test-server.js",
    "chatbot:test": "node scripts/test-chat.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "job",
    "career",
    "ai",
    "navigator"
  ],
  "author": "mrkingsleyobi",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.37",
    "@ai-sdk/openai": "^2.0.53",
    "@clerk/clerk-sdk-node": "^4.0.0",
    "@prisma/client": "^5.0.0",
    "@sentry/node": "^10.26.0",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "ai": "^5.0.78",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "node-cache": "^5.1.2",
    "prom-client": "^15.1.3",
    "winston": "^3.18.3",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.0.0",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "prisma": "^5.0.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
