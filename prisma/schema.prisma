// Prisma schema for JobNaut
// Based on the technical implementation plan

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table
model User {
  id              Int       @id @default(autoincrement())
  clerkId         String    @unique
  email           String    @unique
  name            String?
  location        String?
  experienceLevel String?
  skills          Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  savedJobs       SavedJob[]
  conversations   Conversation[]
  activities      UserActivity[]
  skillGapAnalyses SkillGapAnalysis[]
}

// Jobs table
model Job {
  id              Int       @id @default(autoincrement())
  title           String
  company         String
  location        String
  description     String
  skills          Json
  postedDate      DateTime
  applicationLink String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  savedBy         SavedJob[]
  skillGapAnalyses SkillGapAnalysis[]

  // Add indexes for frequently queried fields
  @@index([title])
  @@index([company])
  @@index([location])
  @@index([postedDate])
  @@index([title, company, location])
  @@index([description])
  @@index([skills])
}

// Saved jobs table
model SavedJob {
  id              Int      @id @default(autoincrement())
  userId          Int
  jobId           Int
  notes           String?
  applicationStatus String?
  savedAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  job             Job      @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([savedAt])
}

// Conversation table - Chat history persistence
model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@index([userId])
  @@index([createdAt])
}

// Message table - Individual chat messages
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  role           String       // 'user' or 'assistant'
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// UserActivity table - Analytics and tracking
model UserActivity {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String   // 'job_search', 'job_view', 'job_save', etc.
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action])
}

// SkillGapAnalysis table - Store analysis results
model SkillGapAnalysis {
  id               Int      @id @default(autoincrement())
  userId           Int
  jobId            Int
  matchingSkills   Json
  missingSkills    Json
  matchPercentage  Float
  recommendations  Json
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
  job              Job      @relation(fields: [jobId], references: [id])

  @@index([userId, jobId])
  @@index([createdAt])
  @@index([matchPercentage])
}