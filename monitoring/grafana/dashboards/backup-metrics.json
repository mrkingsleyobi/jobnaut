{
  "dashboard": {
    "id": null,
    "uid": "backup-metrics",
    "title": "Backup & Recovery Metrics",
    "tags": ["backup", "disaster-recovery", "jobnaut"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "type": "stat",
        "title": "Last Backup Time",
        "targets": [
          {
            "expr": "time() - backup_age_seconds{type=\"postgresql\"}",
            "refId": "A",
            "legendFormat": "PostgreSQL"
          },
          {
            "expr": "time() - backup_age_seconds{type=\"redis\"}",
            "refId": "B",
            "legendFormat": "Redis"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "dateTimeFromNow",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 86400, "color": "yellow" },
                { "value": 172800, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "type": "stat",
        "title": "Backup Success Rate (24h)",
        "targets": [
          {
            "expr": "sum(increase(backup_success_total[24h])) / (sum(increase(backup_success_total[24h])) + sum(increase(backup_failure_total[24h]))) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 95, "color": "yellow" },
                { "value": 99, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "type": "graph",
        "title": "Backup Size Over Time",
        "targets": [
          {
            "expr": "backup_size_bytes{type=\"postgresql\"}",
            "refId": "A",
            "legendFormat": "PostgreSQL"
          },
          {
            "expr": "backup_size_bytes{type=\"redis\"}",
            "refId": "B",
            "legendFormat": "Redis"
          }
        ],
        "yaxes": [
          {
            "label": "Size",
            "format": "bytes"
          },
          {
            "label": null,
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 2,
        "points": false,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true
        }
      },
      {
        "id": 4,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "type": "graph",
        "title": "Backup Duration",
        "targets": [
          {
            "expr": "backup_duration_seconds{type=\"postgresql\"}",
            "refId": "A",
            "legendFormat": "PostgreSQL"
          },
          {
            "expr": "backup_duration_seconds{type=\"redis\"}",
            "refId": "B",
            "legendFormat": "Redis"
          }
        ],
        "yaxes": [
          {
            "label": "Duration",
            "format": "s"
          },
          {
            "label": null,
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 2,
        "points": false,
        "legend": {
          "show": true,
          "values": true,
          "current": true,
          "avg": true
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [3600],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "name": "Backup Duration Alert"
        }
      },
      {
        "id": 5,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "type": "graph",
        "title": "Backup Success/Failure Rate",
        "targets": [
          {
            "expr": "rate(backup_success_total[5m])",
            "refId": "A",
            "legendFormat": "Success - {{ type }}"
          },
          {
            "expr": "rate(backup_failure_total[5m])",
            "refId": "B",
            "legendFormat": "Failure - {{ type }}"
          }
        ],
        "yaxes": [
          {
            "label": "Rate",
            "format": "ops"
          },
          {
            "label": null,
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "bars": false,
        "stack": false,
        "legend": {
          "show": true
        }
      },
      {
        "id": 6,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "type": "stat",
        "title": "Backup Age",
        "targets": [
          {
            "expr": "backup_age_seconds{type=\"postgresql\"}",
            "refId": "A",
            "legendFormat": "PostgreSQL"
          },
          {
            "expr": "backup_age_seconds{type=\"redis\"}",
            "refId": "B",
            "legendFormat": "Redis"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "dtdurations",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 86400, "color": "yellow" },
                { "value": 172800, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
        "type": "table",
        "title": "Backup Status Summary",
        "targets": [
          {
            "expr": "backup_success_total",
            "refId": "A",
            "format": "table",
            "instant": true
          },
          {
            "expr": "backup_failure_total",
            "refId": "B",
            "format": "table",
            "instant": true
          },
          {
            "expr": "backup_age_seconds",
            "refId": "C",
            "format": "table",
            "instant": true
          },
          {
            "expr": "backup_size_bytes",
            "refId": "D",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "job": true,
                "instance": true
              },
              "indexByName": {
                "type": 0,
                "Value #A": 1,
                "Value #B": 2,
                "Value #C": 3,
                "Value #D": 4
              },
              "renameByName": {
                "type": "Backup Type",
                "Value #A": "Successes",
                "Value #B": "Failures",
                "Value #C": "Age (seconds)",
                "Value #D": "Size (bytes)"
              }
            }
          }
        ],
        "options": {
          "showHeader": true
        },
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Size (bytes)"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "bytes"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Age (seconds)"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "s"
                }
              ]
            }
          ]
        }
      },
      {
        "id": 8,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "type": "graph",
        "title": "Cloud Upload Status",
        "targets": [
          {
            "expr": "rate(backup_cloud_upload_success_total[5m])",
            "refId": "A",
            "legendFormat": "Success - {{ type }}"
          },
          {
            "expr": "rate(backup_cloud_upload_failures_total[5m])",
            "refId": "B",
            "legendFormat": "Failure - {{ type }}"
          }
        ],
        "yaxes": [
          {
            "label": "Rate",
            "format": "ops"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1
      },
      {
        "id": 9,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "type": "stat",
        "title": "Storage Utilization",
        "targets": [
          {
            "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/var/backups\"} / node_filesystem_size_bytes{mountpoint=\"/var/backups\"}) * 100)",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 80, "color": "yellow" },
                { "value": 90, "color": "red" }
              ]
            },
            "max": 100,
            "min": 0
          }
        }
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertname=~\"Backup.*\", alertstate=\"firing\"}",
          "iconColor": "red",
          "name": "Backup Alerts",
          "tagKeys": "alertname",
          "textFormat": "{{ alertname }}: {{ annotations.summary }}",
          "titleFormat": "Alert"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}
