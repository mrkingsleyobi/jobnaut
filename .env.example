# AI Service Configuration for JobNaut

# Default AI provider ('openai', 'anthropic', or 'mock')
AI_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307

# Retry configuration
AI_TIMEOUT=30000
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_DELAY=1000
AI_RETRY_BACKOFF_MULTIPLIER=2

# Mock configuration
AI_MOCK_ENABLED=true
AI_MOCK_DELAY=1000

# Redis Cache Configuration
# Development: redis://localhost:6379
# Production: redis://:password@redis:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL=300

# Sentry Error Tracking Configuration
SENTRY_DSN=
SENTRY_RELEASE=jobnaut@1.0.0
SENTRY_ENVIRONMENT=development

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_FILES=14
LOG_MAX_SIZE=10485760

# Monitoring Configuration
PROMETHEUS_ENABLED=true
METRICS_PORT=3001

# Grafana Configuration (for docker-compose.monitoring.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3002
