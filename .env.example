# JobNaut Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# Application Configuration
# =============================================================================

# Application environment (development, test, production)
NODE_ENV=development

# Server port
PORT=3000

# =============================================================================
# Security
# =============================================================================

# Encryption key for sensitive data (min 32 characters)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=dev-encryption-key-min-32-chars-required-for-security

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/jobnaut

# =============================================================================
# Authentication - Clerk
# =============================================================================

# Get these from: https://dashboard.clerk.dev
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=

# =============================================================================
# AI Service Configuration
# =============================================================================

# Default AI provider ('openai', 'anthropic', or 'mock')
AI_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307

# Retry configuration
AI_TIMEOUT=30000
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_DELAY=1000
AI_RETRY_BACKOFF_MULTIPLIER=2

# Mock configuration
AI_MOCK_ENABLED=true
AI_MOCK_DELAY=1000

# Redis Cache Configuration
# Development: redis://localhost:6379
# Production: redis://:password@redis:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL=300

# Sentry Error Tracking Configuration
SENTRY_DSN=
SENTRY_RELEASE=jobnaut@1.0.0
SENTRY_ENVIRONMENT=development

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_FILES=14
LOG_MAX_SIZE=10485760

# Monitoring Configuration
PROMETHEUS_ENABLED=true
METRICS_PORT=3001

# Grafana Configuration (for docker-compose.monitoring.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3002

# Alertmanager Configuration
# Slack webhook URL for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email notification settings
ALERT_EMAIL_TO=alerts@jobnaut.com
ALERT_EMAIL_FROM=noreply@jobnaut.com
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# PagerDuty integration (optional)
PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key

# =============================================================================
# Application URLs
# =============================================================================

# Frontend application URL
FRONTEND_URL=http://localhost:3000

# Backend API base URL
API_BASE_URL=http://localhost:4000

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed CORS origins (comma-separated)
# Leave empty to use defaults based on NODE_ENV
CORS_ORIGIN=

# =============================================================================
# Rate Limiting
# =============================================================================

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 500 dev, 100 prod)
RATE_LIMIT_MAX_REQUESTS=500

# Maximum auth requests per window (default: 5)
AUTH_RATE_LIMIT_MAX=5

# =============================================================================
# Backup Configuration
# =============================================================================

# Database Backup Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobnaut
DB_USER=postgres
PGPASSWORD=your_database_password_here

# Redis Backup Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATA_DIR=/var/lib/redis

# Backup Storage Configuration
BACKUP_DIR=/var/backups/jobnaut
BACKUP_S3_BUCKET=jobnaut-backups
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Backup Retention and Settings
RETENTION_DAYS=30
COMPRESSION_LEVEL=9
VERIFY_BACKUP=true

# Backup Notifications
BACKUP_EMAIL_RECIPIENTS=ops@example.com,admin@example.com
NOTIFICATION_EMAIL=ops@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
